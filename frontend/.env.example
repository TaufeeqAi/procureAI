# Phase 0 has no backend dependency — the app runs entirely on route
# scaffolding and typed contracts. These variables are placeholders for
# Phase 3 onward and are safe to leave unset until then.

# Base URL of the FastAPI backend (introduced in Phase 3)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Shows the "DEMO MODE" indicator in the header (introduced in Phase 7)
NEXT_PUBLIC_DEMO_MODE=true
