APP_NAME=Elecon Procurement AI
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEMO_MODE=true
DATABASE_URL=postgresql+asyncpg://elecon:elecon@localhost:5432/elecon_procurement
SYNC_DATABASE_URL=postgresql+psycopg://elecon:elecon@localhost:5432/elecon_procurement
SQL_ECHO=false
CORS_ORIGINS=["http://localhost:3000"]

# Primary LLM (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Fallback LLM (Groq)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
GROQ_TEMPERATURE=0
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2

LANGGRAPH_CHECKPOINT_ENABLED=true
LANGGRAPH_CHECKPOINT_SETUP_REQUIRED=true
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
AI_GRAPH_VERSION=procurement-graph.v1
AI_PROMPT_VERSION=procurement-prompts.v1