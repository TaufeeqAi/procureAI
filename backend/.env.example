APP_NAME="Elecon Procurement API"
ENVIRONMENT=development
DEBUG=true

# asyncpg URL for the running app; alembic derives its own sync URL from
# this automatically (see app/core/config.py's sync_database_url) — set
# this once, not twice.
DATABASE_URL=postgresql+asyncpg://elecon:elecon@localhost:5432/elecon_procurement

CORS_ORIGINS_RAW=http://localhost:3000

API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
